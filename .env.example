# Environment & Build Configuration Example
# Copy this file to .env for local automated build script customization

# Target Unity Version
UNITY_VERSION=2023.1.20f1

# Default Build Output Target Platform (Win64 | WebGL | OSXUniversal | Linux64)
BUILD_TARGET=Win64

# Build Output Path
BUILD_OUTPUT_DIR=Builds/Win64/Asteroids.exe

# Development Build Flag (true | false)
DEVELOPMENT_BUILD=false
